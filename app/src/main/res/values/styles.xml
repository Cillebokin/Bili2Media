<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Bili2Media.Settings" parent="Theme.Bili2Media">
        <item name="colorPrimary">@color/bili2media_settings_accent</item>
        <item name="colorOnPrimary">@color/bili2media_settings_text_on_accent</item>
        <item name="colorSecondary">@color/bili2media_settings_accent</item>
        <item name="colorOnSecondary">@color/bili2media_settings_text_on_accent</item>
        <item name="colorAccent">@color/bili2media_settings_accent</item>
        <item name="colorControlActivated">@color/bili2media_settings_accent</item>
        <item name="android:colorAccent">@color/bili2media_settings_accent</item>
        <item name="android:colorControlActivated">@color/bili2media_settings_accent</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@color/bili2media_settings_background</item>
        <item name="android:navigationBarColor">@color/bili2media_settings_background</item>
        <item name="android:windowBackground">@color/bili2media_settings_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Widget.Bili2Media.SettingsSwitch" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:thumb">@drawable/bg_bili2media_settings_switch_thumb</item>
        <item name="track">@drawable/selector_bili2media_settings_switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
        <item name="switchMinWidth">36dp</item>
        <item name="switchPadding">10dp</item>
        <item name="showText">false</item>
        <item name="splitTrack">false</item>
    </style>
</resources>
