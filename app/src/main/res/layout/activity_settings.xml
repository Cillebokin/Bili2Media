<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bili2media_settings_background">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bili2media_settings_background"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/layoutSettingsToolbar"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_settings_card"
        android:elevation="@dimen/card_elevation"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/settings"
            android:textColor="@color/bili2media_settings_text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back"
            android:scaleType="centerInside"
            android:src="@drawable/png_back_icon"
            app:tint="@color/bili2media_settings_icon" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="true"
        android:fillViewport="false"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSettingsToolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cardAppearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_settings_card"
                android:clipToOutline="true"
                android:elevation="@dimen/card_elevation"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="yes"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:text="@string/language"
                        android:textColor="@color/bili2media_settings_text_primary"
                        android:textSize="@dimen/text_section"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLanguageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:drawableEnd="@drawable/ic_chevron_right_24"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:text="@string/language_current_chinese"
                        android:textColor="@color/bili2media_settings_text_secondary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/dark_mode"
                        android:textColor="@color/bili2media_settings_text_primary"
                        android:textSize="@dimen/text_section"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchDarkMode"
                        style="@style/Widget.Bili2Media.SettingsSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/dark_mode"
                        android:importantForAccessibility="yes" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardDirectorySettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="@dimen/card_elevation"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/directory_settings"
                    android:textColor="@color/bili2media_settings_text_primary"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/rowInputDirectory"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="yes"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/input_directory_label"
                        android:textColor="@color/bili2media_settings_text_primary"
                        android:textSize="@dimen/text_section"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvInputDirectoryValue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:drawableEnd="@drawable/ic_chevron_right_24"
                        android:drawablePadding="8dp"
                        android:ellipsize="middle"
                        android:gravity="center_vertical|end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textColor="@color/bili2media_settings_text_secondary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowOutputDirectory"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="yes"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/output_directory_label"
                        android:textColor="@color/bili2media_settings_text_primary"
                        android:textSize="@dimen/text_section"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOutputDirectoryValue"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:drawableEnd="@drawable/ic_chevron_right_24"
                        android:drawablePadding="8dp"
                        android:ellipsize="middle"
                        android:gravity="center_vertical|end"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textColor="@color/bili2media_settings_text_secondary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardExportSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="@dimen/card_elevation"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/export_settings"
                    android:textColor="@color/bili2media_settings_text_primary"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/rowMp3Bitrate"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="yes"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/mp3_bitrate"
                            android:textColor="@color/bili2media_settings_text_primary"
                            android:textSize="@dimen/text_section"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/mp3_lossy_hint"
                            android:textColor="@color/bili2media_settings_text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvMp3BitrateValue"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:drawableEnd="@drawable/ic_chevron_right_24"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:textColor="@color/bili2media_settings_text_secondary"
                        android:textSize="@dimen/text_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_settings_card"
                android:elevation="@dimen/card_elevation"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="16dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about"
                    android:textColor="@color/bili2media_settings_text_primary"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAppAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:text="@string/app_author"
                    android:textColor="@color/bili2media_settings_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvAppVersion"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:gravity="center_vertical"
                    android:text="@string/app_version"
                    android:textColor="@color/bili2media_settings_text_secondary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tvAppLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:autoLink="web"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:linksClickable="true"
                    android:minHeight="32dp"
                    android:text="@string/app_link"
                    android:textColor="@color/bili2media_settings_accent"
                    android:textColorLink="@color/bili2media_settings_accent"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
